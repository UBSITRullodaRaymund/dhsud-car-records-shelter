DirectoryIndex index.php
Options -Indexes

RewriteEngine On
RewriteRule ^(app|controllers|models|includes|views|database)(/|$) - [F,L]
RewriteRule ^index\.html$ index.php?route=index&legacy=1 [QSA,L]
RewriteRule ^(.+)\.html$ index.php?route=$1&legacy=1 [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/?$ index.php?route=$1 [QSA,L]

<FilesMatch "^(Code\.gs|.*\.sql|.*\.xlsx)$">
    Require all denied
</FilesMatch>
